from sqlalchemy import create_engine
from sqlalchemy.orm import sessionmaker, declarative_base
import base64

DATABASE_URL = "sqlite:///./images.db"

engine = create_engine(
    DATABASE_URL,
    connect_args={"check_same_thread": False}
)

SessionLocal = sessionmaker(bind=engine, autoflush=False, autocommit=False)
Base = declarative_base()


# Create a database file: gallery.db
def create_database():
    conn = sqlite3.connect('gallery.db')
    c = conn.cursor()
    c.execute('''CREATE TABLE IF NOT EXISTS images
                 (id INTEGER PRIMARY KEY AUTOINCREMENT, image_data TEXT)''')
    conn.commit()
    conn.close()

# Function to insert image
def insert_image(image_data):
    conn = sqlite3.connect('gallery.db')
    c = conn.cursor()
    c.execute("INSERT INTO images (image_data) VALUES (?)", (image_data,))
    conn.commit()
    conn.close()

# Function to fetch all images
def fetch_all_images():
    conn = sqlite3.connect('gallery.db')
    c = conn.cursor()
    c.execute("SELECT * FROM images")
    rows = c.fetchall()
    conn.close()
    return rows

# Function to delete image by id
def delete_image(id):
    conn = sqlite3.connect('gallery.db')
    c = conn.cursor()
    c.execute("DELETE FROM images WHERE id=?", (id,))
    conn.commit()
    conn.close()

# Example usage
if __name__ == "__main__":
    create_database()
    
    # Example image data
    with open("example_image.jpg", "rb") as image_file:
        image_data = base64.b64encode(image_file.read()).decode('utf-8')
    
    insert_image(image_data)
    print(fetch_all_images())
    delete_image(1)
    print(fetch_all_images())
